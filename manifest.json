{
  "name": "Aidova — Say It Your Way",
  "short_name": "Aidova",
  "description": "Free AAC communication app for non-verbal children, autism, ALS and stroke survivors. By CHEWAID®",
  "start_url": "/aidovaapp/",
  "scope": "/aidovaapp/",
  "id": "/aidovaapp/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui", "browser"],
  "orientation": "portrait",
  "background_color": "#e8f5e9",
  "theme_color": "#2D6A4F",
  "lang": "en-GB",
  "dir": "ltr",
  "categories": ["medical", "education", "health"],
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "play",
